NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hotel_aurora
DB_USER=root
DB_PASSWORD=
# SSL para proveedores MySQL en la nube (TiDB Cloud, Aiven, PlanetScale, etc.):
# DB_SSL=true
# Opción A: Ruta al archivo PEM (ej. ./certs/isrgrootx1.pem en local o /etc/secrets/isrgrootx1.pem en Render Secret Files)
# DB_SSL_CA_PATH=./certs/isrgrootx1.pem
# Opción B: Contenido del certificado PEM directamente en variable de entorno
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Debe coincidir con el rol público del esquema actual (nunca admin).
USER_ROLE=usuario
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Solo detrás de un proxy conocido: TRUST_PROXY_HOPS=1
HOTEL_TIMEZONE=America/Argentina/Buenos_Aires
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CURRENCY=USD
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
